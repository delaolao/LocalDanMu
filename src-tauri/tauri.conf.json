{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalDanMu",
  "version": "0.3.5",
  "identifier": "com.localdanmu.desktop",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "LocalDanMu",
    "copyright": "MIT",
    "shortDescription": "线下培训弹幕互动平台",
    "longDescription": "局域网自建的培训弹幕系统：讲师本机开窗，观众扫码发弹幕，内容实时叠在 PPT 之上，数据不出本机。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
